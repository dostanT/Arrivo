        "notification.title.wakeup" : {
            "extractionState" : "manual",
            "localizations" : {
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Wake up, time to conquer the world!"
                    }
                },
                "kk" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Оян, әлемді бағындыратын уақыт келді!"
                    }
                },
                "ru" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Просыпайся, пора покорять мир!"
                    }
                }
            }
        },
        "notification.subtitle.wakeup" : {
            "extractionState" : "manual",
            "localizations" : {
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Before important things, a nap won't hurt 😆"
                    }
                },
                "kk" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Маңызды істер алдында кішкене ұйықтап алған дұрыс 😆"
                    }
                },
                "ru" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Перед важными делами поспать не помешает 😆"
                    }
                }
            }
        },
        "notification.title.lunch" : {
            "extractionState" : "manual",
            "localizations" : {
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "\"Time to eat. I know a great place\""
                    }
                },
                "kk" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "\"Тамақтанатын уақыт. Жақсы бір жер білемін\""
                    }
                },
                "ru" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "\"Пора есть. Я знаю хорошее место\""
                    }
                }
            }
        },
        "notification.subtitle.lunch" : {
            "extractionState" : "manual",
            "localizations" : {
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Turned out to be far away... Taking a quick nap ✔️"
                    }
                },
                "kk" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Алыс екен... Кішкене ұйықтап алайын ✔️"
                    }
                },
                "ru" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Оказалось далеко... Посплю немного ✔️"
                    }
                }
            }
        },
